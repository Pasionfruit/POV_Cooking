# Copy to deploy/homelab/.env (gitignored) for the homelab Docker setup (docker-compose.yml).
# Generate the secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   -> JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"         -> ENCRYPTION_KEY
# Never change ENCRYPTION_KEY once accounts exist - emails are encrypted with it.
# To bring over the Render/Atlas data, this must be the ENCRYPTION_KEY from Render.
JWT_SECRET=
ENCRYPTION_KEY=
# Typed on the sign-up page ("Have an admin code?") to make that account an admin
ADMIN_CODE=
# Or: emails that are always admins (comma-separated)
ADMIN_EMAILS=
