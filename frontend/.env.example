# POV Cooking frontend
# Copy to .env for local overrides, or set these in your host's dashboard.
# Vite only exposes variables prefixed with VITE_, and it inlines them at BUILD
# time — changing one means rebuilding, not just restarting.

# Base URL of the API. Leave empty locally: the app defaults to
# http://<the host you loaded the page from>:5001, which is what makes it work
# from a phone on the same Wi-Fi with no config.
# In production set the full https URL of the deployed API, with no trailing slash.
VITE_API_URL=

# Google Sign-In client ID. Must be the same value as GOOGLE_CLIENT_ID on the
# backend. Leave empty to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=
