# POV Cooking backend
# 5001 by default (macOS AirPlay sits on 5000). Hosts set PORT themselves.
PORT=5001

# Set to "production" when deployed. The server then REFUSES to start unless
# JWT_SECRET and ENCRYPTION_KEY are set, and stops seeding the demo accounts.
NODE_ENV=

# Sign JWTs — set a long random string in real use
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# 64-char hex key (32 bytes) used to encrypt usernames/emails at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: never change this once real users exist. Emails are encrypted with
# it and looked up by an HMAC of it, so rotating it locks everyone out.
ENCRYPTION_KEY=

# Leave empty to store data as JSON files in backend/data (fine for local dev).
# Set a MongoDB connection string in production — hosted free tiers give you an
# ephemeral filesystem, so file storage is wiped on every deploy and restart.
MONGODB_URI=
MONGODB_DB=pov_cooking

# Comma-separated list of the exact origins allowed to call this API, e.g.
# https://pov-cooking.vercel.app,http://localhost:5173
# Empty means "allow any origin", which is only OK locally.
CORS_ORIGIN=

# Users who register with this code become admins
ADMIN_CODE=admin-secret

# Comma-separated emails that are always admins (works for Google sign-in too)
ADMIN_EMAILS=

# Google Sign-In: OAuth client ID from https://console.cloud.google.com/apis/credentials
# Leave empty to disable Google login (email/password still works).
# Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# Seed demo@povcooking.com / admin@povcooking.com. Defaults to on outside
# production and off in production. Set "true" to force them on.
SEED_DEMO=
